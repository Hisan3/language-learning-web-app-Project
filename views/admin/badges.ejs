<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Badge Management - LearnGlow Admin</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 2rem;
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            background: white;
            padding: 2rem;
            border-radius: 1rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .header h1 {
            color: #1f2937;
            margin-bottom: 0.5rem;
        }

        .header p {
            color: #6b7280;
        }

        .back-link {
            display: inline-block;
            color: #8b5cf6;
            text-decoration: none;
            margin-top: 1rem;
            font-weight: 600;
        }

        .back-link:hover {
            color: #7c3aed;
        }

        .card {
            background: white;
            border-radius: 1rem;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 2rem;
        }

        .card-title {
            font-size: 1.5rem;
            color: #1f2937;
            margin-bottom: 1.5rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            color: #374151;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e5e7eb;
            border-radius: 0.5rem;
            font-size: 1rem;
            transition: border-color 0.3s;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            outline: none;
            border-color: #8b5cf6;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 0.5rem;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-danger {
            background: #ef4444;
            color: white;
        }

        .btn-danger:hover {
            background: #dc2626;
        }

        .btn-edit {
            background: #3b82f6;
            color: white;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
        }

        .btn-edit:hover {
            background: #2563eb;
        }

        .badges-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .badge-card {
            background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
            border-radius: 1rem;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            transition: transform 0.3s;
        }

        .badge-card:hover {
            transform: translateY(-5px);
        }

        .badge-header {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .badge-icon-display {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
        }

        .badge-info {
            flex: 1;
        }

        .badge-name {
            font-size: 1.125rem;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 0.25rem;
        }

        .badge-type {
            font-size: 0.875rem;
            color: #6b7280;
            text-transform: capitalize;
        }

        .badge-description {
            color: #4b5563;
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
        }

        .badge-threshold {
            display: inline-block;
            background: white;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-weight: 600;
            color: #8b5cf6;
            font-size: 0.875rem;
        }

        .badge-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .alert {
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
        }

        .alert-success {
            background: #d1fae5;
            color: #065f46;
        }

        .alert-error {
            background: #fee2e2;
            color: #991b1b;
        }

        .color-picker {
            display: grid;
            grid-template-columns: repeat(auto-fill, 40px);
            gap: 0.5rem;
        }

        .color-option {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 3px solid transparent;
            cursor: pointer;
            transition: all 0.3s;
        }

        .color-option:hover {
            border-color: #1f2937;
        }

        .color-option.selected {
            border-color: #1f2937;
            transform: scale(1.1);
        }

        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .badges-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>🏅 Badge Management</h1>
            <p>Create and manage achievement badges for learners</p>
            <a href="/admin" class="back-link">← Back to Dashboard</a>
        </div>

        <!-- Add New Badge Form -->
        <div class="card">
            <h2 class="card-title">Add New Badge</h2>
            
            <div id="alert-container"></div>

            <form id="badge-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Badge Name *</label>
                        <input type="text" id="name" name="name" required placeholder="e.g., Master Learner">
                    </div>
                    <div class="form-group">
                        <label for="icon">Icon (Emoji) *</label>
                        <input type="text" id="icon" name="icon" required placeholder="🏆" maxlength="10">
                    </div>
                </div>

                <div class="form-group">
                    <label for="description">Description *</label>
                    <textarea id="description" name="description" required rows="2" placeholder="What this badge represents"></textarea>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="badge_type">Badge Type *</label>
                        <select id="badge_type" name="badge_type" required>
                            <option value="">Select type...</option>
                            <option value="xp">XP Based</option>
                            <option value="lessons">Lessons Completed</option>
                            <option value="streak">Streak Days</option>
                            <option value="pomodoro">Pomodoro Timers</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="threshold">Threshold (Required Value) *</label>
                        <input type="number" id="threshold" name="threshold" required min="1" placeholder="e.g., 500">
                    </div>
                </div>

                <div class="form-group">
                    <label>Badge Color</label>
                    <div class="color-picker">
                        <button type="button" class="color-option selected" data-color="#8b5cf6" style="background: #8b5cf6;"></button>
                        <button type="button" class="color-option" data-color="#10b981" style="background: #10b981;"></button>
                        <button type="button" class="color-option" data-color="#3b82f6" style="background: #3b82f6;"></button>
                        <button type="button" class="color-option" data-color="#f59e0b" style="background: #f59e0b;"></button>
                        <button type="button" class="color-option" data-color="#ef4444" style="background: #ef4444;"></button>
                        <button type="button" class="color-option" data-color="#ec4899" style="background: #ec4899;"></button>
                        <button type="button" class="color-option" data-color="#06b6d4" style="background: #06b6d4;"></button>
                    </div>
                    <input type="hidden" id="color" name="color" value="#8b5cf6">
                </div>

                <button type="submit" class="btn btn-primary">Create Badge</button>
            </form>
        </div>

        <!-- Existing Badges -->
        <div class="card">
            <h2 class="card-title">Existing Badges</h2>
            <div id="badges-container" class="badges-grid">
                <!-- Badges will be loaded here -->
            </div>
        </div>
    </div>

    <script>
        let badges = [];
        let selectedColor = '#8b5cf6';

        // Color picker
        document.querySelectorAll('.color-option').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                document.querySelectorAll('.color-option').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                selectedColor = btn.dataset.color;
                document.getElementById('color').value = selectedColor;
            });
        });

        // Load badges
        async function loadBadges() {
            try {
                const response = await fetch('/api/badges/list');
                const data = await response.json();
                
                if (data.success) {
                    badges = data.badges;
                    displayBadges();
                }
            } catch (error) {
                console.error('Error loading badges:', error);
            }
        }

        // Display badges
        function displayBadges() {
            const container = document.getElementById('badges-container');
            
            if (badges.length === 0) {
                container.innerHTML = '<p style="color: #6b7280;">No badges created yet.</p>';
                return;
            }

            container.innerHTML = badges.map(badge => `
                <div class="badge-card">
                    <div class="badge-header">
                        <div class="badge-icon-display" style="background: ${badge.color || '#8b5cf6'}">
                            ${badge.icon || '🏆'}
                        </div>
                        <div class="badge-info">
                            <div class="badge-name">${badge.name}</div>
                            <div class="badge-type">${badge.badge_type}</div>
                        </div>
                    </div>
                    <div class="badge-description">${badge.description || 'No description'}</div>
                    <div class="badge-threshold">
                        Requires: ${badge.threshold} ${badge.badge_type === 'xp' ? 'XP' : badge.badge_type === 'lessons' ? 'Lessons' : badge.badge_type === 'streak' ? 'Days' : 'Timers'}
                    </div>
                    <div class="badge-actions">
                        <button class="btn btn-edit" onclick="editBadge(${badge.id})">Edit</button>
                        <button class="btn btn-danger" onclick="deleteBadge(${badge.id})">Delete</button>
                    </div>
                </div>
            `).join('');
        }

        // Create badge
        document.getElementById('badge-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = {
                name: document.getElementById('name').value,
                description: document.getElementById('description').value,
                icon: document.getElementById('icon').value,
                color: selectedColor,
                badge_type: document.getElementById('badge_type').value,
                threshold: parseInt(document.getElementById('threshold').value)
            };

            try {
                const response = await fetch('/admin/badges/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (data.success) {
                    showAlert('Badge created successfully!', 'success');
                    document.getElementById('badge-form').reset();
                    selectedColor = '#8b5cf6';
                    document.querySelector('.color-option').classList.add('selected');
                    loadBadges();
                } else {
                    showAlert('Error: ' + data.error, 'error');
                }
            } catch (error) {
                showAlert('Error creating badge', 'error');
                console.error(error);
            }
        });

        // Delete badge
        async function deleteBadge(id) {
            if (!confirm('Are you sure you want to delete this badge?')) return;

            try {
                const response = await fetch(`/admin/badges/delete/${id}`, {
                    method: 'DELETE'
                });

                const data = await response.json();

                if (data.success) {
                    showAlert('Badge deleted successfully!', 'success');
                    loadBadges();
                } else {
                    showAlert('Error: ' + data.error, 'error');
                }
            } catch (error) {
                showAlert('Error deleting badge', 'error');
                console.error(error);
            }
        }

        // Show alert
        function showAlert(message, type) {
            const container = document.getElementById('alert-container');
            container.innerHTML = `<div class="alert alert-${type}">${message}</div>`;
            setTimeout(() => {
                container.innerHTML = '';
            }, 5000);
        }

        // Load badges on page load
        loadBadges();
    </script>
</body>
</html>
