<%- include('../partials/header', { pageTitle: 'Blog Management', activePage: 'blog' }) %>

<style>
  /* Blog-specific styles */
  .blog-image-preview {
    max-width: 150px;
    max-height: 100px;
    border-radius: 8px;
    border: 2px solid #e9ecef;
    object-fit: cover;
    object-position: center;
    margin-top: 10px;
    display: block;
  }

  .badge {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
  }

  .badge-featured {
    background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
    color: #b45309;
  }

  .badge-learning {
    background: #e0e7ff;
    color: #4f46e5;
  }

  .badge-productivity {
    background: #fce7f3;
    color: #db2777;
  }

  .badge-wellbeing {
    background: #d4f4dd;
    color: #27ae60;
  }

  .badge-published {
    background: #84fab0;
    color: #2d3748;
  }

  .badge-draft {
    background: #fef3c7;
    color: #b45309;
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-y: auto;
  }

  .modal.active {
    display: flex;
  }

  .modal-content {
    background: white;
    border-radius: 25px;
    padding: 30px;
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    animation: slideUp 0.3s ease;
    position: relative;
  }

  @keyframes slideUp {
    from { transform: translateY(50px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .modal-header {
    font-size: 24px;
    font-weight: 700;
    color: #2d3748;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-label {
    display: block;
    font-weight: 600;
    color: #4a5568;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 12px;
    border: 2px solid #E0E7FF;
    border-radius: 12px;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    transition: all 0.3s ease;
    background: #fafafa;
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: #667eea;
    background: white;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .form-hint {
    font-size: 12px;
    color: #718096;
    margin-top: 4px;
    font-style: italic;
  }

  .required {
    color: #e11d48;
  }

  .form-actions {
    display: flex;
    gap: 10px;
    margin-top: 25px;
    padding-top: 20px;
    border-top: 2px solid #f0f0f0;
  }

  .btn-submit {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 12px 24px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    font-weight: 500;
    font-family: 'Poppins', sans-serif;
    flex: 1;
  }

  .btn-submit:hover {
    transform: scale(1.05);
  }

  .btn-cancel {
    background: linear-gradient(135deg, #ffa62b 0%, #ff6b6b 100%);
    color: white;
    padding: 12px 24px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    font-weight: 500;
    font-family: 'Poppins', sans-serif;
  }

  .btn-cancel:hover {
    transform: scale(1.05);
  }

  .image-upload-options {
    display: flex;
    gap: 15px;
    margin-top: 10px;
  }

  .upload-option {
    flex: 1;
  }

  .close-modal {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    font-size: 32px;
    cursor: pointer;
    color: #a0aec0;
    line-height: 1;
  }

  .close-modal:hover {
    color: #667eea;
  }

  .checkbox-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .checkbox-group input[type="checkbox"] {
    width: 20px;
    height: 20px;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .image-upload-options {
      flex-direction: column;
    }
  }
</style>

<!-- Success/Error Messages -->
<% if (typeof success !== 'undefined' && success) { %>
  <div style="background: #84fab0; color: #2d3748; padding: 15px 20px; border-radius: 12px; margin-bottom: 20px; animation: slideDown 0.3s ease;">
    ✅ <%= success %>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background: #fee140; color: #c53030; padding: 15px 20px; border-radius: 12px; margin-bottom: 20px; animation: slideDown 0.3s ease;">
    ❌ <%= error %>
  </div>
<% } %>

<h1 class="header-title">📝 Blog Management</h1>
<p class="header-subtitle">Create and manage blog posts for LearnGlow</p>

<div class="content-panel">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px;">
    <h2 class="panel-title">All Blog Posts (<%= posts.length %>)</h2>
    <button class="btn btn-success" onclick="openAddModal()">+ Add New Post</button>
  </div>

  <% if (posts.length > 0) { %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Category</th>
            <th>Read Time</th>
            <th>Featured</th>
            <th>Status</th>
            <th>Published</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% posts.forEach(post => { %>
            <tr>
              <td>
                <% if (post.image_url) { %>
                  <img src="<%= post.image_url %>" alt="<%= post.title %>" class="blog-image-preview">
                <% } else { %>
                  <div style="width: 150px; height: 100px; background: #f0f0f0; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #a0aec0;">
                    No Image
                  </div>
                <% } %>
              </td>
              <td>
                <strong><%= post.title %></strong>
                <p style="font-size: 12px; color: #718096; margin-top: 5px;"><%= post.excerpt.substring(0, 80) %>...</p>
              </td>
              <td>
                <% if (post.category === 'Learning Tips') { %>
                  <span class="badge badge-learning">📚 Learning Tips</span>
                <% } else if (post.category === 'Productivity') { %>
                  <span class="badge badge-productivity">🎯 Productivity</span>
                <% } else if (post.category === 'Well-being') { %>
                  <span class="badge badge-wellbeing">💚 Well-being</span>
                <% } else { %>
                  <span class="badge"><%= post.category %></span>
                <% } %>
              </td>
              <td><%= post.read_time %></td>
              <td>
                <% if (post.featured) { %>
                  <span class="badge badge-featured">⭐ Featured</span>
                <% } else { %>
                  <span style="color: #a0aec0;">-</span>
                <% } %>
              </td>
              <td>
                <% if (post.status === 'published') { %>
                  <span class="badge badge-published">Published</span>
                <% } else { %>
                  <span class="badge badge-draft">Draft</span>
                <% } %>
              </td>
              <td>
                <%= post.published_at ? new Date(post.published_at).toLocaleDateString() : '-' %>
              </td>
              <td>
                <div class="action-buttons">
                  <button class="btn-edit" onclick='openEditModal(<%= JSON.stringify(post) %>)'>Edit</button>
                  <form action="/admin/blog/delete/<%= post.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this blog post?');">
                    <button type="submit" class="btn-delete">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon">📝</div>
      <h3>No blog posts yet</h3>
      <p>Click "+ Add New Post" to create your first blog post</p>
    </div>
  <% } %>
</div>

<!-- Add Blog Post Modal -->
<div id="addBlogModal" class="modal">
  <div class="modal-content">
    <button class="close-modal" onclick="closeAddModal()">&times;</button>
    <h2 class="modal-header">📝 Add New Blog Post</h2>
    <form action="/admin/blog/add" method="POST" enctype="multipart/form-data">
      
      <div class="form-group">
        <label for="add_title" class="form-label">Post Title <span class="required">*</span></label>
        <input 
          type="text" 
          id="add_title" 
          name="title" 
          class="form-input" 
          placeholder="e.g., 10 Proven Techniques to Master Vocabulary Faster"
          required
        >
      </div>

      <div class="form-group">
        <label for="add_excerpt" class="form-label">Excerpt/Summary <span class="required">*</span></label>
        <textarea 
          id="add_excerpt" 
          name="excerpt" 
          class="form-textarea" 
          placeholder="Brief summary of the blog post (shown in cards)..."
          rows="3"
          required
        ></textarea>
        <p class="form-hint">Keep it under 150 characters for best display</p>
      </div>

      <div class="form-group">
        <label for="add_content" class="form-label">Full Content <span class="required">*</span></label>
        <textarea 
          id="add_content" 
          name="content" 
          class="form-textarea" 
          placeholder="Full blog post content (supports HTML formatting)..."
          rows="10"
          required
        ></textarea>
        <p class="form-hint">You can use HTML tags for formatting</p>
      </div>

      <div class="form-group">
        <label for="add_category" class="form-label">Category <span class="required">*</span></label>
        <select id="add_category" name="category" class="form-select" required>
          <option value="">Select Category</option>
          <option value="Learning Tips">📚 Learning Tips</option>
          <option value="Productivity">🎯 Productivity</option>
          <option value="Well-being">💚 Well-being</option>
        </select>
      </div>

      <div class="form-group">
        <label for="add_read_time" class="form-label">Read Time <span class="required">*</span></label>
        <input 
          type="text" 
          id="add_read_time" 
          name="read_time" 
          class="form-input" 
          placeholder="e.g., 5 min read"
          value="5 min read"
          required
        >
        <p class="form-hint">Format: "X min read" (e.g., "5 min read", "10 min read")</p>
      </div>

      <div class="form-group">
        <label class="form-label">Featured Image</label>
        <p class="form-hint" style="margin-bottom: 10px;">Choose one option: upload an image file OR provide an image URL</p>
        
        <div style="background: #f7fafc; padding: 15px; border-radius: 12px; margin-bottom: 10px;">
          <label for="add_image_file" class="form-label">📤 Upload Image File</label>
          <input 
            type="file" 
            id="add_image_file" 
            name="image_file" 
            accept="image/*" 
            class="form-input"
          >
          <p class="form-hint">Recommended: 1200x800px, max 2MB</p>
        </div>

        <div style="text-align: center; padding: 10px; color: #a0aec0; font-weight: 600;">
          - OR -
        </div>

        <div style="background: #f7fafc; padding: 15px; border-radius: 12px;">
          <label for="add_image_url" class="form-label">🔗 Image URL</label>
          <input 
            type="url" 
            id="add_image_url" 
            name="image_url" 
            class="form-input" 
            placeholder="https://images.unsplash.com/photo-..."
          >
          <p class="form-hint">Use Unsplash, external CDN, or any public image URL</p>
        </div>
      </div>

      <div class="form-group">
        <div class="checkbox-group">
          <input 
            type="checkbox" 
            id="add_featured" 
            name="featured" 
            value="true"
          >
          <label for="add_featured" class="form-label" style="margin: 0;">
            ⭐ Mark as Featured Post
          </label>
        </div>
        <p class="form-hint">Featured posts appear at the top of the blog page</p>
      </div>

      <div class="form-group">
        <label for="add_status" class="form-label">Status <span class="required">*</span></label>
        <select id="add_status" name="status" class="form-select" required>
          <option value="published">✅ Published</option>
          <option value="draft">📝 Draft</option>
        </select>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-submit">💾 Save Blog Post</button>
        <button type="button" class="btn-cancel" onclick="closeAddModal()">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Blog Post Modal -->
<div id="editBlogModal" class="modal">
  <div class="modal-content">
    <button class="close-modal" onclick="closeEditModal()">&times;</button>
    <h2 class="modal-header">✏️ Edit Blog Post</h2>
    <form id="editBlogForm" method="POST" enctype="multipart/form-data">
      
      <div class="form-group">
        <label for="edit_title" class="form-label">Post Title <span class="required">*</span></label>
        <input 
          type="text" 
          id="edit_title" 
          name="title" 
          class="form-input" 
          required
        >
      </div>

      <div class="form-group">
        <label for="edit_excerpt" class="form-label">Excerpt/Summary <span class="required">*</span></label>
        <textarea 
          id="edit_excerpt" 
          name="excerpt" 
          class="form-textarea" 
          rows="3"
          required
        ></textarea>
      </div>

      <div class="form-group">
        <label for="edit_content" class="form-label">Full Content <span class="required">*</span></label>
        <textarea 
          id="edit_content" 
          name="content" 
          class="form-textarea" 
          rows="10"
          required
        ></textarea>
      </div>

      <div class="form-group">
        <label for="edit_category" class="form-label">Category <span class="required">*</span></label>
        <select id="edit_category" name="category" class="form-select" required>
          <option value="">Select Category</option>
          <option value="Learning Tips">📚 Learning Tips</option>
          <option value="Productivity">🎯 Productivity</option>
          <option value="Well-being">💚 Well-being</option>
        </select>
      </div>

      <div class="form-group">
        <label for="edit_read_time" class="form-label">Read Time <span class="required">*</span></label>
        <input 
          type="text" 
          id="edit_read_time" 
          name="read_time" 
          class="form-input" 
          required
        >
      </div>

      <div id="currentImageContainer" class="form-group" style="display: none;">
        <label class="form-label">Current Image</label>
        <img id="current_image_preview" src="" alt="Current image" class="blog-image-preview">
        <div class="checkbox-group" style="margin-top: 10px;">
          <input type="checkbox" id="delete_image" name="delete_image" value="true">
          <label for="delete_image" class="form-label" style="margin: 0;">🗑️ Delete current image</label>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Update Featured Image (Optional)</label>
        
        <div style="background: #f7fafc; padding: 15px; border-radius: 12px; margin-bottom: 10px;">
          <label for="edit_image_file" class="form-label">📤 Upload New Image</label>
          <input 
            type="file" 
            id="edit_image_file" 
            name="image_file" 
            accept="image/*" 
            class="form-input"
          >
        </div>

        <div style="text-align: center; padding: 10px; color: #a0aec0; font-weight: 600;">
          - OR -
        </div>

        <div style="background: #f7fafc; padding: 15px; border-radius: 12px;">
          <label for="edit_image_url" class="form-label">🔗 New Image URL</label>
          <input 
            type="url" 
            id="edit_image_url" 
            name="image_url" 
            class="form-input" 
            placeholder="https://images.unsplash.com/photo-..."
          >
        </div>
      </div>

      <div class="form-group">
        <div class="checkbox-group">
          <input 
            type="checkbox" 
            id="edit_featured" 
            name="featured" 
            value="true"
          >
          <label for="edit_featured" class="form-label" style="margin: 0;">
            ⭐ Mark as Featured Post
          </label>
        </div>
      </div>

      <div class="form-group">
        <label for="edit_status" class="form-label">Status <span class="required">*</span></label>
        <select id="edit_status" name="status" class="form-select" required>
          <option value="published">✅ Published</option>
          <option value="draft">📝 Draft</option>
        </select>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-submit">💾 Update Blog Post</button>
        <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
  // Modal functions
  function openAddModal() {
    document.getElementById('addBlogModal').classList.add('active');
  }

  function closeAddModal() {
    document.getElementById('addBlogModal').classList.remove('active');
  }

  function openEditModal(post) {
    const modal = document.getElementById('editBlogModal');
    const form = document.getElementById('editBlogForm');
    
    // Set form action
    form.action = `/admin/blog/edit/${post.id}`;
    
    // Populate form fields
    document.getElementById('edit_title').value = post.title || '';
    document.getElementById('edit_excerpt').value = post.excerpt || '';
    document.getElementById('edit_content').value = post.content || '';
    document.getElementById('edit_category').value = post.category || '';
    document.getElementById('edit_read_time').value = post.read_time || '5 min read';
    document.getElementById('edit_featured').checked = post.featured || false;
    document.getElementById('edit_status').value = post.status || 'published';
    
    // Show current image if exists
    const imageContainer = document.getElementById('currentImageContainer');
    if (post.image_url) {
      document.getElementById('current_image_preview').src = post.image_url;
      imageContainer.style.display = 'block';
    } else {
      imageContainer.style.display = 'none';
    }
    
    // Show modal
    modal.classList.add('active');
  }

  function closeEditModal() {
    document.getElementById('editBlogModal').classList.remove('active');
  }

  // Mobile menu toggle
  document.getElementById('menuToggle')?.addEventListener('click', function() {
    document.getElementById('sidebar').classList.toggle('open');
  });

  // Auto-hide success/error messages
  setTimeout(() => {
    const messages = document.querySelectorAll('[style*="slideDown"]');
    messages.forEach(msg => {
      msg.style.transition = 'opacity 0.5s ease';
      msg.style.opacity = '0';
      setTimeout(() => msg.remove(), 500);
    });
  }, 5000);
</script>

<%- include('../partials/footer') %>