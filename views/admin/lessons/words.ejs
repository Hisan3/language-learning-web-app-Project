<%- include('../partials/header', { pageTitle: 'Word of the Day', activePage: 'wordofday' }) %>

<style>
/* ----------------------------------
    WORD OF THE DAY STYLES
---------------------------------- */
.word-title {
  font-size: 28px;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}

.word-subtitle {
  color: #718096;
  margin-bottom: 30px;
  font-size: 14px;
}

/* ----------------------------------
      CONTENT PANEL
---------------------------------- */
.content-panel {
  background: white;
  border-radius: 25px;
  padding: 30px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  gap: 15px;
  flex-wrap: wrap;
}

/* ----------------------------------
      TODAY'S WORD CARD
---------------------------------- */
.today-word-card {
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
  padding: 30px;
  border-radius: 20px;
  margin-bottom: 30px;
}

.today-word-label {
  font-size: 14px;
  color: #666;
  margin-bottom: 5px;
}

.today-word-title {
  font-size: 36px;
  font-weight: 700;
  margin-bottom: 10px;
  color: #2d3748;
}

.today-word-definition {
  font-size: 16px;
  color: #555;
  margin-bottom: 15px;
}

.today-word-definition strong {
  font-weight: 600;
}

.today-word-example {
  font-size: 16px;
  color: #555;
}

/* ----------------------------------
      FILTER SECTION
---------------------------------- */
.filter-group {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}

.filter-select {
  padding: 12px 16px;
  border: 2px solid #E0E7FF;
  border-radius: 12px;
  font-size: 14px;
  font-family: 'Poppins', sans-serif;
  background: white;
  cursor: pointer;
  transition: all 0.3s ease;
  min-width: 150px;
}

.filter-select:focus {
  outline: none;
  border-color: #667eea;
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

/* ----------------------------------
      BUTTONS
---------------------------------- */
.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 12px 24px;
  border-radius: 12px;
  text-decoration: none;
  font-weight: 500;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-family: 'Poppins', sans-serif;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
}

.btn-edit {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 8px 16px;
  border-radius: 10px;
  border: none;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: 'Poppins', sans-serif;
}

.btn-edit:hover {
  transform: scale(1.05);
}

.btn-delete {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  color: white;
  padding: 8px 16px;
  border-radius: 10px;
  border: none;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: 'Poppins', sans-serif;
}

.btn-delete:hover {
  transform: scale(1.05);
}

.btn-clear-filter {
  background: #f0f0f0;
  color: #666;
  padding: 12px 20px;
  border-radius: 12px;
  border: none;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: 'Poppins', sans-serif;
}

.btn-clear-filter:hover {
  background: #e0e0e0;
}

/* ----------------------------------
      TABLE STYLES
---------------------------------- */
.table-container {
  overflow-x: auto;
}

.data-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0 10px;
}

.data-table th {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 15px;
  text-align: left;
  font-weight: 600;
  font-size: 14px;
}

.data-table th:first-child {
  border-radius: 12px 0 0 12px;
}

.data-table th:last-child {
  border-radius: 0 12px 12px 0;
}

.data-table td {
  background: #F8F9FF;
  padding: 15px;
  border: none;
  font-size: 14px;
  color: #4a5568;
}

.data-table tr td:first-child {
  border-radius: 12px 0 0 12px;
}

.data-table tr td:last-child {
  border-radius: 0 12px 12px 0;
}

.data-table tbody tr {
  transition: all 0.2s ease;
}

.data-table tbody tr:hover td {
  background: #eef2ff;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.15);
}

/* ----------------------------------
      BADGES
---------------------------------- */
.badge {
  display: inline-block;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
}

.badge-scheduled {
  background: #d4f4dd;
  color: #27ae60;
}

.badge-published {
  background: #dbeafe;
  color: #3b82f6;
}

.badge-archived {
  background: #fef3c7;
  color: #f59e0b;
}

/* ----------------------------------
      ACTION BUTTONS
---------------------------------- */
.action-buttons {
  display: flex;
  gap: 8px;
}

/* ----------------------------------
      EMPTY STATE
---------------------------------- */
.empty-state {
  text-align: center;
  padding: 80px 20px;
}

.empty-state-icon {
  font-size: 80px;
  margin-bottom: 20px;
  opacity: 0.3;
}

.empty-state h3 {
  color: #4a5568;
  font-size: 22px;
  margin-bottom: 12px;
}

.empty-state p {
  color: #a0aec0;
  font-size: 14px;
}

/* ----------------------------------
      MODAL STYLES
---------------------------------- */
.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.modal.active {
  display: flex;
}

.modal-content {
  background: white;
  border-radius: 25px;
  padding: 30px;
  max-width: 600px;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

@keyframes slideUp {
  from { transform: translateY(50px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-header {
  font-size: 24px;
  font-weight: 700;
  color: #2d3748;
  margin-bottom: 25px;
  display: flex;
  align-items: center;
  gap: 10px;
}

/* ----------------------------------
      FORM STYLES
---------------------------------- */
.form-group {
  margin-bottom: 20px;
}

.form-label {
  display: block;
  font-weight: 600;
  color: #4a5568;
  margin-bottom: 8px;
  font-size: 14px;
}

.form-input, .form-select, .form-textarea {
  width: 100%;
  padding: 12px;
  border: 2px solid #E0E7FF;
  border-radius: 12px;
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
  transition: all 0.3s ease;
  background: #fafafa;
}

.form-input:focus, .form-select:focus, .form-textarea:focus {
  outline: none;
  border-color: #667eea;
  background: white;
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.form-textarea {
  resize: vertical;
  min-height: 100px;
}

.required {
  color: #e11d48;
}

.form-actions {
  display: flex;
  gap: 10px;
  margin-top: 25px;
  padding-top: 20px;
  border-top: 2px solid #f0f0f0;
}

.btn-submit {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 12px 24px;
  border-radius: 12px;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  font-weight: 500;
  font-family: 'Poppins', sans-serif;
  flex: 1;
}

.btn-submit:hover {
  transform: scale(1.05);
}

.btn-cancel {
  background: linear-gradient(135deg, #ffa62b 0%, #ff6b6b 100%);
  color: white;
  padding: 12px 24px;
  border-radius: 12px;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  font-weight: 500;
  font-family: 'Poppins', sans-serif;
}

.btn-cancel:hover {
  transform: scale(1.05);
}

.form-hint {
  font-size: 12px;
  color: #718096;
  margin-top: 4px;
  font-style: italic;
}

/* Responsive */
@media (max-width: 768px) {
  .panel-header {
    flex-direction: column;
    align-items: stretch;
  }
  
  .filter-group {
    width: 100%;
  }
  
  .filter-select {
    flex: 1;
  }
  
  .modal-content {
    padding: 20px;
  }
  
  .today-word-title {
    font-size: 28px;
  }
}
</style>

<div class="content-panel">
  <h1 class="word-title">💬 Word of the Day</h1>
  <p class="word-subtitle">Manage daily vocabulary words for students</p>
  
  <div class="panel-header">
    <div class="filter-group">
      <select class="filter-select" id="yearFilter">
        <option value="">All Years</option>
      </select>
      
      <select class="filter-select" id="monthFilter">
        <option value="">All Months</option>
        <option value="1">January</option>
        <option value="2">February</option>
        <option value="3">March</option>
        <option value="4">April</option>
        <option value="5">May</option>
        <option value="6">June</option>
        <option value="7">July</option>
        <option value="8">August</option>
        <option value="9">September</option>
        <option value="10">October</option>
        <option value="11">November</option>
        <option value="12">December</option>
      </select>
      
      <select class="filter-select" id="dayFilter">
        <option value="">All Days</option>
        <% for(let i = 1; i <= 31; i++) { %>
          <option value="<%= i %>"><%= i %></option>
        <% } %>
      </select>
      
      <button class="btn-clear-filter" onclick="clearFilters()">Clear Filters</button>
    </div>
    
    <button class="btn-primary" onclick="openAddModal()">
      + Add Word
    </button>
  </div>
  
  <!-- Today's Word Card -->
  <% if (todayWord) { %>
    <div class="today-word-card">
      <h3 class="today-word-label">Today's Word</h3>
      <h2 class="today-word-title"><%= todayWord.word %></h2>
      <p class="today-word-definition"><strong>Definition:</strong> <%= todayWord.definition %></p>
      <p class="today-word-example"><strong>Example:</strong> "<%= todayWord.example %>"</p>
    </div>
  <% } else { %>
    <div class="today-word-card">
      <h3 class="today-word-label">Today's Word</h3>
      <p style="color: #666; font-size: 16px; margin-top: 10px;">No word scheduled for today. Add one below!</p>
    </div>
  <% } %>
  
  <!-- Words Table -->
  <% if (words.length > 0) { %>
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Word</th>
            <th>Definition</th>
            <th>Date Scheduled</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="wordsTable">
          <% words.forEach(word => { %>
            <tr data-date="<%= word.date_scheduled %>">
              <td><strong><%= word.word %></strong></td>
              <td><%= word.definition %></td>
              <td><%= new Date(word.date_scheduled).toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' }) %></td>
              <td>
                <% if (word.status === 'scheduled') { %>
                  <span class="badge badge-scheduled">Scheduled</span>
                <% } else if (word.status === 'published') { %>
                  <span class="badge badge-published">Published</span>
                <% } else if (word.status === 'archived') { %>
                  <span class="badge badge-archived">Archived</span>
                <% } %>
              </td>
              <td>
                <div class="action-buttons">
                  <button class="btn-edit" onclick='openEditModal(<%= JSON.stringify(word) %>)'>Edit</button>
                  <form action="/admin/wordofday/delete/<%= word.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this word?');">
                    <button type="submit" class="btn-delete">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon">💬</div>
      <h3>No words found</h3>
      <p>Click "+ Add Word" to create your first word of the day</p>
    </div>
  <% } %>
</div>

<!-- Add Word Modal -->
<div id="addWordModal" class="modal">
  <div class="modal-content">
    <h2 class="modal-header">💬 Add New Word</h2>
    <form action="/admin/wordofday/add" method="POST">
      
      <div class="form-group">
        <label for="add_word" class="form-label">Word <span class="required">*</span></label>
        <input 
          type="text" 
          id="add_word" 
          name="word" 
          class="form-input" 
          placeholder="e.g., Serendipity" 
          required
        >
      </div>
      
      <div class="form-group">
        <label for="add_definition" class="form-label">Definition <span class="required">*</span></label>
        <textarea 
          id="add_definition" 
          name="definition" 
          class="form-textarea" 
          placeholder="The occurrence of events by chance in a happy way..."
          required
        ></textarea>
      </div>
      
      <div class="form-group">
        <label for="add_example" class="form-label">Example Sentence <span class="required">*</span></label>
        <textarea 
          id="add_example" 
          name="example" 
          class="form-textarea" 
          placeholder="A fortunate stroke of serendipity brought the two old friends together after years."
          required
        ></textarea>
      </div>
      
      <div class="form-group">
        <label for="add_date_scheduled" class="form-label">Date Scheduled <span class="required">*</span></label>
        <input 
          type="date" 
          id="add_date_scheduled" 
          name="date_scheduled" 
          class="form-input" 
          required
        >
        <p class="form-hint">Choose a future date for when this word will appear</p>
      </div>
      
      <div class="form-group">
        <label for="add_status" class="form-label">Status <span class="required">*</span></label>
        <select id="add_status" name="status" class="form-select" required>
          <option value="scheduled">Scheduled</option>
          <option value="published">Published</option>
          <option value="archived">Archived</option>
        </select>
      </div>
      
      <div class="form-actions">
        <button type="submit" class="btn-submit">💾 Save Word</button>
        <button type="button" class="btn-cancel" onclick="closeAddModal()">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Word Modal -->
<div id="editWordModal" class="modal">
  <div class="modal-content">
    <h2 class="modal-header">✏️ Edit Word</h2>
    <form id="editWordForm" method="POST">
      
      <div class="form-group">
        <label for="edit_word" class="form-label">Word <span class="required">*</span></label>
        <input 
          type="text" 
          id="edit_word" 
          name="word" 
          class="form-input" 
          required
        >
      </div>
      
      <div class="form-group">
        <label for="edit_definition" class="form-label">Definition <span class="required">*</span></label>
        <textarea 
          id="edit_definition" 
          name="definition" 
          class="form-textarea" 
          required
        ></textarea>
      </div>
      
      <div class="form-group">
        <label for="edit_example" class="form-label">Example Sentence <span class="required">*</span></label>
        <textarea 
          id="edit_example" 
          name="example" 
          class="form-textarea" 
          required
        ></textarea>
      </div>
      
      <div class="form-group">
        <label for="edit_date_scheduled" class="form-label">Date Scheduled <span class="required">*</span></label>
        <input 
          type="date" 
          id="edit_date_scheduled" 
          name="date_scheduled" 
          class="form-input" 
          required
        >
      </div>
      
      <div class="form-group">
        <label for="edit_status" class="form-label">Status <span class="required">*</span></label>
        <select id="edit_status" name="status" class="form-select" required>
          <option value="scheduled">Scheduled</option>
          <option value="published">Published</option>
          <option value="archived">Archived</option>
        </select>
      </div>
      
      <div class="form-actions">
        <button type="submit" class="btn-submit">💾 Update Word</button>
        <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
  // ============================================
  // 🌍 TIMEZONE DETECTION FOR ADMIN PANEL
  // Ensures "Today's Word" uses admin's local timezone
  // ============================================
  
  // Detect admin's timezone and reload page with timezone parameter
  (function() {
    const urlParams = new URLSearchParams(window.location.search);
    const currentTimezone = urlParams.get('timezone');
    const adminTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    
    console.log('🌍 Admin timezone:', adminTimezone);
    console.log('🔍 Current URL timezone:', currentTimezone);
    
    // If no timezone in URL or different timezone, reload with correct timezone
    if (!currentTimezone || currentTimezone !== adminTimezone) {
      console.log('🔄 Reloading with admin timezone...');
      window.location.href = `/admin/wordofday?timezone=${encodeURIComponent(adminTimezone)}`;
    }
  })();
  
  // Populate year filter dynamically
  const yearFilter = document.getElementById('yearFilter');
  const currentYear = new Date().getFullYear();
  for (let year = currentYear - 1; year <= currentYear + 5; year++) {
    const option = document.createElement('option');
    option.value = year;
    option.textContent = year;
    yearFilter.appendChild(option);
  }
  
  // Filter functionality
  const monthFilter = document.getElementById('monthFilter');
  const dayFilter = document.getElementById('dayFilter');
  const tableRows = document.querySelectorAll('#wordsTable tr');
  
  function filterWords() {
    const selectedYear = yearFilter.value;
    const selectedMonth = monthFilter.value;
    const selectedDay = dayFilter.value;
    
    tableRows.forEach(row => {
      const dateString = row.getAttribute('data-date');
      if (!dateString) return;
      
      const date = new Date(dateString);
      const year = date.getFullYear().toString();
      const month = (date.getMonth() + 1).toString();
      const day = date.getDate().toString();
      
      const yearMatch = !selectedYear || year === selectedYear;
      const monthMatch = !selectedMonth || month === selectedMonth;
      const dayMatch = !selectedDay || day === selectedDay;
      
      row.style.display = (yearMatch && monthMatch && dayMatch) ? '' : 'none';
    });
  }
  
  yearFilter.addEventListener('change', filterWords);
  monthFilter.addEventListener('change', filterWords);
  dayFilter.addEventListener('change', filterWords);
  
  function clearFilters() {
    yearFilter.value = '';
    monthFilter.value = '';
    dayFilter.value = '';
    filterWords();
  }
  
  // Modal functions
  function openAddModal() {
    document.getElementById('addWordModal').classList.add('active');
    // Set default date to tomorrow
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    document.getElementById('add_date_scheduled').value = tomorrow.toISOString().split('T')[0];
  }
  
  function closeAddModal() {
    document.getElementById('addWordModal').classList.remove('active');
  }
  
  function openEditModal(word) {
    document.getElementById('edit_word').value = word.word || '';
    document.getElementById('edit_definition').value = word.definition || '';
    document.getElementById('edit_example').value = word.example || '';
    document.getElementById('edit_date_scheduled').value = word.date_scheduled || '';
    document.getElementById('edit_status').value = word.status || 'scheduled';
    
    // Set form action
    document.getElementById('editWordForm').action = '/admin/wordofday/edit/' + word.id;
    
    document.getElementById('editWordModal').classList.add('active');
  }
  
  function closeEditModal() {
    document.getElementById('editWordModal').classList.remove('active');
  }
  
  // Close modals when clicking outside
  document.querySelectorAll('.modal').forEach(modal => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
      }
    });
  });
  
  // Close modals with Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAddModal();
      closeEditModal();
    }
  });
</script>

<%- include('../partials/footer') %>