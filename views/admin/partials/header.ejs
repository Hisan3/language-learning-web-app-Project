<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' - ' : '' %>LearnGlow Admin ✨</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Poppins', sans-serif;
    }

    body {
      background: linear-gradient(135deg, #E0C3FC 0%, #8EC5FC 100%);
      min-height: 100vh;
    }

    .dashboard-container {
      display: flex;
      min-height: 100vh;
    }

    /* Sidebar Styles */
    .sidebar {
      width: 280px;
      background: linear-gradient(180deg, #FFDEE9 0%, #B5FFFC 100%);
      padding: 30px 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      border-radius: 0 30px 30px 0;
      position: relative;
      overflow-y: auto;
    }

    .sidebar-header {
      text-align: center;
      margin-bottom: 30px;
    }

    .sidebar-header h2 {
      font-size: 26px;
      font-weight: 700;
      color: #667eea;
      margin: 0;
    }

    .sidebar-header p {
      font-size: 14px;
      color: #718096;
      margin-top: 5px;
    }

    .nav-section {
      margin-bottom: 25px;
    }

    .nav-section-title {
      font-size: 12px;
      color: #a0aec0;
      font-weight: 600;
      margin-bottom: 10px;
      padding-left: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .nav-btn {
      display: flex;
      align-items: center;
      width: 100%;
      padding: 12px 16px;
      margin-bottom: 8px;
      background: transparent;
      border: none;
      border-radius: 15px;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      color: #2d3748;
    }

    .nav-btn:hover {
      background: rgba(255, 255, 255, 0.6);
      transform: translateX(5px);
    }

    .nav-btn.active {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .emoji-icon {
      font-size: 20px;
      margin-right: 12px;
    }

    /* Main Content Styles */
    .main-content {
      flex: 1;
      padding: 40px;
      position: relative;
      overflow-y: auto;
    }

    .floating-emoji {
      position: absolute;
      animation: float 3s ease-in-out infinite;
      opacity: 0.3;
      font-size: 48px;
      pointer-events: none;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-20px); }
    }

    .header-title {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .header-subtitle {
      color: #718096;
      margin-bottom: 30px;
      font-size: 16px;
    }

    .content-panel {
      background: white;
      border-radius: 25px;
      padding: 30px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
      margin-bottom: 30px;
      animation: fadeIn 0.5s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .panel-title {
      font-size: 22px;
      font-weight: 600;
      color: #2d3748;
      margin-bottom: 20px;
    }

    .btn {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 12px 24px;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 500;
      border: none;
      cursor: pointer;
      transition: transform 0.2s ease;
      display: inline-block;
    }

    .btn:hover {
      transform: scale(1.05);
    }

    .btn-success {
      background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
      color: #333;
    }

    .btn-danger {
      background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
      padding: 8px 16px;
      font-size: 14px;
    }

    .table-container {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0 10px;
    }

    th {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 15px;
      text-align: left;
      font-weight: 600;
    }

    th:first-child {
      border-radius: 12px 0 0 12px;
    }

    th:last-child {
      border-radius: 0 12px 12px 0;
    }

    td {
      background: #F8F9FF;
      padding: 15px;
    }

    tr td:first-child {
      border-radius: 12px 0 0 12px;
    }

    tr td:last-child {
      border-radius: 0 12px 12px 0;
    }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #718096;
    }

    .empty-state .icon {
      font-size: 64px;
      margin-bottom: 20px;
    }

    /* Mobile Menu */
    #menuToggle {
      position: fixed;
      top: 20px;
      left: 20px;
      z-index: 200;
      background: white;
      padding: 10px 15px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      display: none;
      font-size: 24px;
    }

    @media (max-width: 768px) {
      #menuToggle {
        display: block;
      }

      .sidebar {
        position: fixed;
        left: -280px;
        transition: left 0.3s ease;
        z-index: 100;
        height: 100vh;
      }

      .sidebar.open {
        left: 0;
      }

      .main-content {
        padding: 20px;
      }
    }
  </style>
</head>
<body>
  <!-- Mobile Menu Button -->
  <button id="menuToggle">☰</button>

  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <h2>✨ LearnGlow</h2>
        <p>Admin Dashboard</p>
      </div>

      <nav>
        <!-- Overview Section -->
        <div class="nav-section">
          <div class="nav-section-title">Overview</div>
          <a href="/admin" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
            <span class="emoji-icon">📊</span>
            <span>Dashboard</span>
          </a>
        </div>

        <!-- User Management Section -->
        <div class="nav-section">
          <div class="nav-section-title">User Management</div>
          <a href="/admin/users" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'users' ? 'active' : '' %>">
            <span class="emoji-icon">👥</span>
            <span>All Users</span>
          </a>
          <a href="/admin/badges" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'badges' ? 'active' : '' %>">
            <span class="emoji-icon">🏆</span>
            <span>Badges & Achievements</span>
          </a>
          <a href="/admin/gamification" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'gamification' ? 'active' : '' %>">
            <span class="emoji-icon">🎮</span>
            <span>Gamification Stats</span>
          </a>
          <a href="/admin/streaks" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'streaks' ? 'active' : '' %>">
            <span class="emoji-icon">🔥</span>
            <span>Streak Management</span>
          </a>
        </div>

        <!-- Content Management Section -->
        <div class="nav-section">
          <div class="nav-section-title">Content Management</div>
          <a href="/admin/lessons" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'lessons' ? 'active' : '' %>">
            <span class="emoji-icon">📚</span>
            <span>Lessons</span>
          </a>
          <a href="/admin/blog" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'blog' ? 'active' : '' %>">
            <span class="emoji-icon">📝</span>
            <span>Blog</span>
          </a>
          <a href="/admin/wordofday" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'wordofday' ? 'active' : '' %>">
            <span class="emoji-icon">💬</span>
            <span>Word of the Day</span>
          </a>
        </div>

        <!-- Practice Section -->
        <div class="nav-section">
          <div class="nav-section-title">Practice</div>
          <a href="/admin/practice/quizzes" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'quizzes' ? 'active' : '' %>">
            <span class="emoji-icon">📝</span>
            <span>Quizzes</span>
          </a>
          <a href="/admin/practice/flashcards" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'flashcards' ? 'active' : '' %>">
            <span class="emoji-icon">🎴</span>
            <span>Flashcards</span>
          </a>
          <a href="/admin/practice/sentence-making" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'sentence-making' ? 'active' : '' %>">
            <span class="emoji-icon">✏️</span>
            <span>Sentence Making</span>
          </a>
          <a href="/admin/practice/fill-blanks" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'fill-blanks' ? 'active' : '' %>">
            <span class="emoji-icon">✍️</span>
            <span>Fill in the Blanks</span>
          </a>
          <a href="/admin/practice/analytics" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'analytics' ? 'active' : '' %>">
            <span class="emoji-icon">📊</span>
            <span>Analytics</span>
          </a>
        </div>

        <!-- Productivity Section -->
        <div class="nav-section">
          <div class="nav-section-title">Productivity</div>
          <a href="/admin/tasks" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'tasks' ? 'active' : '' %>">
            <span class="emoji-icon">✅</span>
            <span>Task Categories</span>
          </a>
          <a href="/admin/productivity/studytracker" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'studytracker' ? 'active' : '' %>">
            <span class="emoji-icon">📊</span>
            <span>Study Tracker</span>
          </a>
        </div>

        <!-- Mindcare Section -->
        <div class="nav-section">
          <div class="nav-section-title">Mindcare</div>
          <a href="/admin/mindcare" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'mindcare' ? 'active' : '' %>">
            <span class="emoji-icon">🌸</span>
            <span>Mood Quiz</span>
          </a>
          <a href="/admin/mindcare/breathinganalytics" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'breathing' ? 'active' : '' %>">
            <span class="emoji-icon">🧘‍♀️</span>
            <span>Breathing Exercises</span>
          </a>
          <a href="/admin/affirmations" class="nav-btn <%= typeof activePage !== 'undefined' && activePage === 'affirmations' ? 'active' : '' %>">
            <span class="emoji-icon">💭</span>
            <span>Daily Affirmations</span>
          </a>
        </div>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <!-- Floating Emojis -->
      <div class="floating-emoji" style="top: 50px; right: 100px; animation-delay: 0s;">✨</div>
      <div class="floating-emoji" style="top: 200px; right: 50px; animation-delay: 1s;">🌸</div>
      <div class="floating-emoji" style="bottom: 100px; right: 150px; animation-delay: 2s;">📚</div>