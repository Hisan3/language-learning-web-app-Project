<%- include('../partials/header', { pageTitle: 'Practice Analytics', activePage: 'analytics' }) %>

<h1 class="header-title">📊 Practice Analytics</h1>
<p class="header-subtitle">Monitor user performance and engagement</p>

<div class="content-panel">
  <div style="margin-bottom: 30px;">
    <h2 class="panel-title">📈 Performance Overview</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-top: 20px;">
      <!-- Flashcards Stats -->
      <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 25px; border-radius: 20px; color: white;">
        <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 10px;">
          <div style="font-size: 2.5rem;">🎴</div>
          <div>
            <h3 style="margin: 0; font-size: 1.5rem; color: white;"><%= stats.flashcardsCompleted || 0 %></h3>
            <p style="margin: 0; opacity: 0.9; font-size: 14px;">Flashcards Completed</p>
          </div>
        </div>
      </div>

      <!-- Quizzes Stats -->
      <div style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); padding: 25px; border-radius: 20px; color: white;">
        <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 10px;">
          <div style="font-size: 2.5rem;">📝</div>
          <div>
            <h3 style="margin: 0; font-size: 1.5rem; color: white;"><%= stats.quizzesCompleted || 0 %></h3>
            <p style="margin: 0; opacity: 0.9; font-size: 14px;">Quizzes Taken</p>
          </div>
        </div>
      </div>

      <!-- Exercises Stats -->
      <div style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); padding: 25px; border-radius: 20px; color: white;">
        <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 10px;">
          <div style="font-size: 2.5rem;">✏️</div>
          <div>
            <h3 style="margin: 0; font-size: 1.5rem; color: white;"><%= stats.exercisesCompleted || 0 %></h3>
            <p style="margin: 0; opacity: 0.9; font-size: 14px;">Exercises Completed</p>
          </div>
        </div>
      </div>

      <!-- Fill Blanks Stats -->
      <div style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); padding: 25px; border-radius: 20px; color: white;">
        <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 10px;">
          <div style="font-size: 2.5rem;">✍️</div>
          <div>
            <h3 style="margin: 0; font-size: 1.5rem; color: white;"><%= stats.fillBlanksCompleted || 0 %></h3>
            <p style="margin: 0; opacity: 0.9; font-size: 14px;">Fill Blanks Completed</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Top Performers -->
  <div style="margin-bottom: 30px;">
    <h2 class="panel-title">🏆 Top Performers (XP Rankings)</h2>
    <% if (topPerformers && topPerformers.length > 0) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 20px;">
        <% topPerformers.slice(0, 3).forEach((performer, index) => { %>
          <div style="background: white; border: 2px solid #e9d5ff; border-radius: 20px; padding: 20px;">
            <div style="display: flex; align-items: center; gap: 15px;">
              <div style="font-size: 2.5rem;">
                <%= index === 0 ? '🥇' : index === 1 ? '🥈' : '🥉' %>
              </div>
              <div style="flex: 1;">
                <h3 style="margin: 0 0 5px 0; color: #581c87;"><%= performer.user_email || 'User ' + (index + 1) %></h3>
                <p style="margin: 0; color: #64748b; font-size: 14px;">
                  <strong style="color: #7c3aed; font-size: 1.3rem;"><%= performer.total_xp %> XP</strong>
                </p>
                <p style="margin: 5px 0 0 0; color: #64748b; font-size: 13px;">
                  <%= performer.total_activities || 0 %> activities completed
                </p>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="icon">🏆</div>
        <p>No top performers today yet. Users will appear here as they earn XP!</p>
      </div>
    <% } %>
  </div>

  <!-- Recent Activity -->
  <div>
    <h2 class="panel-title">🕒 Recent Activity</h2>
    <% if (recentActivities && recentActivities.length > 0) { %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>User</th>
              <th>Activity Type</th>
              <th>Score</th>
              <th>XP Earned</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% recentActivities.forEach(activity => { %>
              <tr>
                <td><strong><%= activity.user_email || 'Anonymous' %></strong></td>
                <td>
                  <span style="background: #f3e8ff; color: #7c3aed; padding: 4px 12px; border-radius: 12px; font-size: 13px;">
                    <%= activity.activity_type %>
                  </span>
                </td>
                <td>
                  <span style="color: <%= activity.score >= 80 ? '#16a34a' : activity.score >= 50 ? '#f59e0b' : '#dc2626' %>; font-weight: 600;">
                    <%= activity.score %>%
                  </span>
                </td>
                <td>
                  <span style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 4px 12px; border-radius: 12px; font-size: 13px; font-weight: 600;">
                    +<%= activity.xp_earned || 0 %> XP
                  </span>
                </td>
                <td><%= new Date(activity.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="icon">📊</div>
        <p>No activity today yet. Users will start appearing here as they complete exercises!</p>
      </div>
    <% } %>
  </div>
</div>

<style>
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #faf5ff;
    border-radius: 20px;
    border: 2px dashed #e9d5ff;
  }

  .empty-state .icon {
    font-size: 4rem;
    margin-bottom: 15px;
  }

  .empty-state p {
    color: #64748b;
    font-size: 1rem;
  }
</style>

<script>
  // Mobile menu toggle
  document.getElementById('menuToggle').addEventListener('click', function() {
    document.getElementById('sidebar').classList.toggle('open');
  });

  // Auto-refresh every 60 seconds
  setTimeout(function() {
    location.reload();
  }, 60000);
</script>

<%- include('../partials/footer') %>