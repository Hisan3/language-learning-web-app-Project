<%- include('../partials/header', { pageTitle: 'Fill in the Blanks Sets Management', activePage: 'fill-blanks' }) %>

<style>
  .badge {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
  }

  .badge-published {
    background: #84fab0;
    color: #2d3748;
  }

  .badge-scheduled {
    background: #ffd1dc;
    color: #c53030;
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
    padding: 20px;
  }

  .modal.active {
    display: flex;
  }

  .modal-content {
    background: white;
    border-radius: 25px;
    padding: 30px;
    max-width: 800px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    animation: slideUp 0.3s ease;
    position: relative;
  }

  @keyframes slideUp {
    from { transform: translateY(50px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .form-input {
    width: 100%;
    padding: 12px;
    border: 2px solid #E0E7FF;
    border-radius: 12px;
    margin-bottom: 15px;
    transition: border-color 0.3s ease;
    font-family: 'Poppins', sans-serif;
  }

  .form-input:focus {
    outline: none;
    border-color: #667eea;
  }

  .question-block {
    background: #F7FAFC;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 15px;
    border-left: 4px solid #ffa500;
  }

  .close-modal {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    font-size: 32px;
    cursor: pointer;
    color: #a0aec0;
    line-height: 1;
    transition: color 0.2s;
  }

  .close-modal:hover {
    color: #667eea;
  }

  .btn-add-question {
    background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
    color: #333;
    padding: 10px 20px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    font-weight: 500;
    transition: transform 0.2s;
    margin-bottom: 20px;
    width: 100%;
  }

  .btn-add-question:hover {
    transform: scale(1.02);
  }

  .btn-remove {
    background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
    color: white;
    padding: 6px 12px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 12px;
  }
</style>

<h1 class="header-title">✍️ Fill in the Blanks Sets Management</h1>
<p class="header-subtitle">Create and manage fill-in-the-blank exercises with scheduling</p>

<div class="content-panel">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2 class="panel-title">All Fill in the Blanks Sets</h2>
    <button class="btn btn-success" onclick="openAddModal()">+ Add New Set</button>
  </div>

  <!-- Filter Section -->
<div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px; border-radius: 20px; margin-bottom: 20px;">
  <h3 style="color: white; margin: 0 0 15px 0; font-size: 16px; font-weight: 600;">🔍 Filter Fill Blanks Sets</h3>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
    <div>
      <label style="display: block; color: white; margin-bottom: 5px; font-size: 14px;">Category</label>
      <select id="filterCategory" class="form-input" onchange="applyFilters()" style="margin-bottom: 0;">
        <option value="">All Categories</option>
        <option value="Student">Student</option>
        <option value="Professional">Professional</option>
        <option value="Business">Business</option>
        <option value="Academic">Academic</option>
        <option value="Advanced">Advanced</option>
        <option value="Intermediate">Intermediate</option>
        <option value="Beginner">Beginner</option>
      </select>
    </div>
    <div>
      <label style="display: block; color: white; margin-bottom: 5px; font-size: 14px;">Year</label>
      <select id="filterYear" class="form-input" onchange="applyFilters()" style="margin-bottom: 0;">
        <option value="">All Years</option>
      </select>
    </div>
    <div>
      <label style="display: block; color: white; margin-bottom: 5px; font-size: 14px;">Month</label>
      <select id="filterMonth" class="form-input" onchange="applyFilters()" style="margin-bottom: 0;">
        <option value="">All Months</option>
        <option value="01">January</option>
        <option value="02">February</option>
        <option value="03">March</option>
        <option value="04">April</option>
        <option value="05">May</option>
        <option value="06">June</option>
        <option value="07">July</option>
        <option value="08">August</option>
        <option value="09">September</option>
        <option value="10">October</option>
        <option value="11">November</option>
        <option value="12">December</option>
      </select>
    </div>
    <div>
      <label style="display: block; color: white; margin-bottom: 5px; font-size: 14px;">Specific Date</label>
      <input type="date" id="filterDate" class="form-input" onchange="applyFilters()" style="margin-bottom: 0;">
    </div>
    <div style="display: flex; align-items: flex-end;">
      <button onclick="clearFilters()" class="btn" style="background: white; color: #667eea; width: 100%; margin-bottom: 0;">Clear Filters</button>
    </div>
  </div>
</div>

  <% if (fillblankSets && fillblankSets.length > 0) { %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Set Title</th>
            <th>Category</th>
            <th>Questions</th>
            <th>Date Scheduled</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
<tbody id="fillblankTableBody">  <!-- For fill-blanks -->
          <% fillblankSets.forEach(set => { %>
            <tr class="fillblank-row" data-category="<%= set.category %>" data-date="<%= set.date_scheduled %>">
              <td><strong><%= set.title %></strong></td>
              <td><%= set.category %></td>
              <td><%= set.total_questions %> questions</td>
              <td><%= new Date(set.date_scheduled).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
              <td>
                <span class="badge <%= set.status === 'Published' ? 'badge-published' : 'badge-scheduled' %>">
                  <%= set.status %>
                </span>
              </td>
              <td>
                <button 
                  class="btn edit-fillblanks-btn" 
                  style="padding: 8px 16px; font-size: 14px; margin-right: 5px;" 
                  data-set-id="<%= set.id %>"
                  data-set-title="<%= set.title %>"
                  data-set-category="<%= set.category %>"
                  data-set-status="<%= set.status %>"
                  data-set-date="<%= set.date_scheduled %>"
                  data-set-questions="<%= encodeURIComponent(JSON.stringify(set.questions)) %>">
                  ✏️ Edit
                </button>
                <form action="/admin/practice/fill-blanks/delete/<%= set.id %>" method="POST" style="display: inline;">
                  <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this fill-in-the-blanks set?')">🗑️ Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="icon">✍️</div>
      <p>No fill-in-the-blanks sets yet. Click "Add New Set" to create your first set!</p>
    </div>
  <% } %>
</div>

<!-- Add Fill in the Blanks Set Modal -->
<div id="addModal" class="modal">
  <div class="modal-content">
    <button class="close-modal" onclick="closeAddModal()">&times;</button>
    <h2 style="font-size: 24px; font-weight: 700; color: #2d3748; margin-bottom: 20px;">✍️ Add New Fill in the Blanks Set</h2>
    
    <form action="/admin/practice/fill-blanks/add" method="POST">
      <label style="display: block; font-weight: 600; color: #4a5568; margin-bottom: 5px;">Set Title</label>
      <input type="text" name="title" class="form-input" placeholder="e.g., Present Tense Practice" required>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
        <div>
          <label style="display: block; font-weight: 600; color: #4a5568; margin-bottom: 5px;">Category</label>
          <select name="category" class="form-input" required>
            <option value="">Select Category</option>
            <option value="Student">Student</option>
            <option value="Professional">Professional</option>
            <option value="Grammar">Grammar</option>
            <option value="Tenses">Tenses</option>
            <option value="Prepositions">Prepositions</option>
            <option value="Vocabulary">Vocabulary</option>
          </select>
        </div>

        <div>
          <label style="display: block; font-weight: 600; color: #4a5568; margin-bottom: 5px;">Status</label>
          <select name="status" class="form-input" required>
            <option value="Published">Published</option>
            <option value="Scheduled">Scheduled</option>
          </select>
        </div>
      </div>

      <label style="display: block; font-weight: 600; color: #4a5568; margin-bottom: 5px;">Date Scheduled</label>
      <input type="date" name="date_scheduled" class="form-input" required>

      <div style="border-top: 2px solid #E0E7FF; margin: 20px 0; padding-top: 20px;">
        <h3 style="font-size: 18px; font-weight: 600; color: #4a5568; margin-bottom: 15px;">Questions</h3>
        <p style="color: #718096; margin-bottom: 15px; font-size: 14px;">
          Use ___ for blanks. Example: "She ___ (go) to school every day."
        </p>
        <div id="questionsContainer">
          <div class="question-block">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
              <label style="font-weight: 600; color: #4a5568;">Question 1</label>
            </div>
            
            <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Sentence with Blank</label>
            <input type="text" name="sentence[]" class="form-input" placeholder="e.g., She ___ (go) to school every day." required>
            
            <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Correct Answer</label>
            <input type="text" name="answer[]" class="form-input" placeholder="e.g., goes" required>
            
            <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Hint</label>
            <input type="text" name="hint[]" class="form-input" placeholder="e.g., Present simple tense" required>
          </div>
        </div>
        <button type="button" class="btn-add-question" onclick="addQuestion()">+ Add Another Question</button>
      </div>

      <div style="display: flex; gap: 10px;">
        <button type="submit" class="btn" style="flex: 1;">💾 Save Set</button>
        <button type="button" class="btn btn-danger" onclick="closeAddModal()" style="flex: 1;">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Fill in the Blanks Set Modal -->
<div id="editModal" class="modal">
  <div class="modal-content">
    <button class="close-modal" onclick="closeEditModal()">&times;</button>
    <h2 style="font-size: 24px; font-weight: 700; color: #2d3748; margin-bottom: 20px;">✏️ Edit Fill in the Blanks Set</h2>
    
    <form id="editForm" method="POST">
      <label style="display: block; font-weight: 600; color: #4a5568; margin-bottom: 5px;">Set Title</label>
      <input type="text" name="title" id="edit_title" class="form-input" required>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
        <div>
          <label style="display: block; font-weight: 600; color: #4a5568; margin-bottom: 5px;">Category</label>
          <select name="category" id="edit_category" class="form-input" required>
            <option value="Student">Student</option>
            <option value="Professional">Professional</option>
            <option value="Grammar">Grammar</option>
            <option value="Tenses">Tenses</option>
            <option value="Prepositions">Prepositions</option>
            <option value="Vocabulary">Vocabulary</option>
          </select>
        </div>

        <div>
          <label style="display: block; font-weight: 600; color: #4a5568; margin-bottom: 5px;">Status</label>
          <select name="status" id="edit_status" class="form-input" required>
            <option value="Published">Published</option>
            <option value="Scheduled">Scheduled</option>
          </select>
        </div>
      </div>

      <label style="display: block; font-weight: 600; color: #4a5568; margin-bottom: 5px;">Date Scheduled</label>
      <input type="date" name="date_scheduled" id="edit_date_scheduled" class="form-input" required>

      <div style="border-top: 2px solid #E0E7FF; margin: 20px 0; padding-top: 20px;">
        <h3 style="font-size: 18px; font-weight: 600; color: #4a5568; margin-bottom: 15px;">Questions</h3>
        <p style="color: #718096; margin-bottom: 15px; font-size: 14px;">
          Use ___ for blanks. Example: "She ___ (go) to school every day."
        </p>
        <div id="editQuestionsContainer"></div>
        <button type="button" class="btn-add-question" onclick="addEditQuestion()">+ Add Another Question</button>
      </div>

      <div style="display: flex; gap: 10px;">
        <button type="submit" class="btn" style="flex: 1;">💾 Update Set</button>
        <button type="button" class="btn btn-danger" onclick="closeEditModal()" style="flex: 1;">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
  let questionCount = 1;
  let editQuestionCount = 0;

  // Mobile menu toggle
  document.getElementById('menuToggle').addEventListener('click', function() {
    document.getElementById('sidebar').classList.toggle('open');
  });

  function openAddModal() {
    document.getElementById('addModal').classList.add('active');
  }

  function closeAddModal() {
    document.getElementById('addModal').classList.remove('active');
    questionCount = 1;
    document.getElementById('questionsContainer').innerHTML = `
      <div class="question-block">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <label style="font-weight: 600; color: #4a5568;">Question 1</label>
        </div>
        
        <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Sentence with Blank</label>
        <input type="text" name="sentence[]" class="form-input" placeholder="e.g., She ___ (go) to school every day." required>
        
        <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Correct Answer</label>
        <input type="text" name="answer[]" class="form-input" placeholder="e.g., goes" required>
        
        <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Hint</label>
        <input type="text" name="hint[]" class="form-input" placeholder="e.g., Present simple tense" required>
      </div>
    `;
  }

  function addQuestion() {
    questionCount++;
    const container = document.getElementById('questionsContainer');
    const newQuestion = document.createElement('div');
    newQuestion.className = 'question-block';
    newQuestion.innerHTML = `
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
        <label style="font-weight: 600; color: #4a5568;">Question ${questionCount}</label>
        <button type="button" class="btn-remove" onclick="this.parentElement.parentElement.remove()">Remove</button>
      </div>
      
      <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Sentence with Blank</label>
      <input type="text" name="sentence[]" class="form-input" required>
      
      <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Correct Answer</label>
      <input type="text" name="answer[]" class="form-input" required>
      
      <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Hint</label>
      <input type="text" name="hint[]" class="form-input" required>
    `;
    container.appendChild(newQuestion);
  }

  function openEditModal(set) {
    document.getElementById('edit_title').value = set.title;
    document.getElementById('edit_category').value = set.category;
    document.getElementById('edit_status').value = set.status;
    document.getElementById('edit_date_scheduled').value = set.date_scheduled.split('T')[0];
    
    const container = document.getElementById('editQuestionsContainer');
    container.innerHTML = '';
    editQuestionCount = 0;
    
    if (set.questions && Array.isArray(set.questions)) {
      set.questions.forEach((q, index) => {
        editQuestionCount++;
        const questionBlock = document.createElement('div');
        questionBlock.className = 'question-block';
        questionBlock.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <label style="font-weight: 600; color: #4a5568;">Question ${index + 1}</label>
            ${index > 0 ? '<button type="button" class="btn-remove" onclick="this.parentElement.parentElement.remove()">Remove</button>' : ''}
          </div>
          
          <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Sentence with Blank</label>
          <input type="text" name="sentence[]" class="form-input" value="${q.sentence}" required>
          
          <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Correct Answer</label>
          <input type="text" name="answer[]" class="form-input" value="${q.answer}" required>
          
          <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Hint</label>
          <input type="text" name="hint[]" class="form-input" value="${q.hint}" required>
        `;
        container.appendChild(questionBlock);
      });
    }
    
    document.getElementById('editForm').action = '/admin/practice/fill-blanks/edit/' + set.id;
    document.getElementById('editModal').classList.add('active');
  }

  function addEditQuestion() {
    editQuestionCount++;
    const container = document.getElementById('editQuestionsContainer');
    const newQuestion = document.createElement('div');
    newQuestion.className = 'question-block';
    newQuestion.innerHTML = `
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
        <label style="font-weight: 600; color: #4a5568;">Question ${editQuestionCount + 1}</label>
        <button type="button" class="btn-remove" onclick="this.parentElement.parentElement.remove()">Remove</button>
      </div>
      
      <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Sentence with Blank</label>
      <input type="text" name="sentence[]" class="form-input" required>
      
      <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Correct Answer</label>
      <input type="text" name="answer[]" class="form-input" required>
      
      <label style="display: block; font-weight: 500; color: #4a5568; margin-bottom: 5px;">Hint</label>
      <input type="text" name="hint[]" class="form-input" required>
    `;
    container.appendChild(newQuestion);
  }

  function closeEditModal() {
    document.getElementById('editModal').classList.remove('active');
  }

  // Close modals when clicking outside
  window.onclick = function(event) {
    if (event.target.classList.contains('modal')) {
      event.target.classList.remove('active');
    }
  }
  // Filter functions
function applyFilters() {
  const category = document.getElementById('filterCategory').value;
  const year = document.getElementById('filterYear').value;
  const month = document.getElementById('filterMonth').value;
  const date = document.getElementById('filterDate').value;

  const rows = document.querySelectorAll('.fillblank-row'); // <-- NOTE: fillblank-row
  rows.forEach(row => {
    const rowCategory = row.getAttribute('data-category');
    const rowDate = row.getAttribute('data-date');

    let showRow = true;

    if (category && category !== rowCategory) {
      showRow = false;
    }

    if (year && !rowDate.startsWith(year)) {
      showRow = false;
    }

    if (month && !rowDate.includes(`-${month}-`)) {
      showRow = false;
    }

    if (date && rowDate !== date) {
      showRow = false;
    }

    row.style.display = showRow ? '' : 'none';
  });
}

function clearFilters() {
  document.getElementById('filterCategory').value = '';
  document.getElementById('filterYear').value = '';
  document.getElementById('filterMonth').value = '';
  document.getElementById('filterDate').value = '';
  applyFilters();
}

// Populate year filter
const currentYear = new Date().getFullYear();
const yearSelect = document.getElementById('filterYear');
for (let i = currentYear; i >= currentYear - 5; i--) {
  const option = document.createElement('option');
  option.value = i;
  option.textContent = i;
  yearSelect.appendChild(option);
}

// Add event listener for edit buttons
document.addEventListener('DOMContentLoaded', function() {
  const editButtons = document.querySelectorAll('.edit-fillblanks-btn');
  editButtons.forEach(button => {
    button.addEventListener('click', function() {
      const setId = this.getAttribute('data-set-id');
      const setTitle = this.getAttribute('data-set-title');
      const setCategory = this.getAttribute('data-set-category');
      const setStatus = this.getAttribute('data-set-status');
      const setDate = this.getAttribute('data-set-date');
      const setQuestions = JSON.parse(decodeURIComponent(this.getAttribute('data-set-questions')));
      
      const set = {
        id: setId,
        title: setTitle,
        category: setCategory,
        status: setStatus,
        date_scheduled: setDate,
        questions: setQuestions
      };
      
      openEditModal(set);
    });
  });
});
</script>

<%- include('../partials/footer') %>
