<%- include('../partials/header', { pageTitle: 'Gamification Stats', activePage: 'gamification' }) %>

<style>
  .gamification-title {
    font-size: 28px;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .gamification-subtitle {
    color: #718096;
    margin-bottom: 30px;
    font-size: 14px;
  }

  .content-panel {
    background: white;
    border-radius: 25px;
    padding: 30px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  }

  .stats-overview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }

  .stat-card {
    background: linear-gradient(135deg, #f8f9ff 0%, #eef2ff 100%);
    border-radius: 16px;
    padding: 20px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(102, 126, 234, 0.15);
  }

  .stat-icon {
    font-size: 36px;
    margin-bottom: 10px;
  }

  .stat-value {
    font-size: 32px;
    font-weight: 700;
    color: #1f2937;
    margin-bottom: 5px;
  }

  .stat-label {
    font-size: 13px;
    color: #6b7280;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .filter-section {
    display: flex;
    gap: 15px;
    margin-bottom: 25px;
    flex-wrap: wrap;
  }

  .filter-group {
    flex: 1;
    min-width: 200px;
  }

  .filter-group label {
    display: block;
    color: #4a5568;
    font-weight: 600;
    margin-bottom: 8px;
    font-size: 13px;
  }

  .filter-group input,
  .filter-group select {
    width: 100%;
    padding: 10px 14px;
    border: 2px solid #e5e7eb;
    border-radius: 10px;
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
    transition: all 0.2s ease;
  }

  .filter-group input:focus,
  .filter-group select:focus {
    outline: none;
    border-color: #8b5cf6;
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
  }

  .table-container {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 10px;
  }

  .data-table th {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 15px 12px;
    text-align: left;
    font-weight: 600;
    font-size: 13px;
    white-space: nowrap;
  }

  .data-table th:first-child {
    border-radius: 12px 0 0 12px;
  }

  .data-table th:last-child {
    border-radius: 0 12px 12px 0;
  }

  .data-table td {
    background: #F8F9FF;
    padding: 15px 12px;
    border: none;
    font-size: 13px;
    color: #4a5568;
  }

  .data-table tr td:first-child {
    border-radius: 12px 0 0 12px;
  }

  .data-table tr td:last-child {
    border-radius: 0 12px 12px 0;
  }

  .data-table tbody tr {
    transition: all 0.2s ease;
  }

  .data-table tbody tr:hover td {
    background: #eef2ff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.15);
  }

  .user-email {
    font-weight: 600;
    color: #1f2937;
  }

  .stat-badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .stat-xp {
    background: #fef3c7;
    color: #92400e;
  }

  .stat-streak {
    background: #fee2e2;
    color: #991b1b;
  }

  .stat-badges {
    background: #dbeafe;
    color: #1e3a8a;
  }

  .stat-lessons {
    background: #d1fae5;
    color: #065f46;
  }

  .stat-practice {
    background: #e0e7ff;
    color: #3730a3;
  }

  .stat-pomodoro {
    background: #fce7f3;
    color: #9f1239;
  }

  .progress-bar-container {
    width: 100px;
    height: 8px;
    background: #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #667eea, #764ba2);
    border-radius: 10px;
    transition: width 0.3s ease;
  }

  .empty-state {
    text-align: center;
    padding: 80px 20px;
  }

  .empty-state-icon {
    font-size: 80px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  .empty-state h3 {
    color: #4a5568;
    font-size: 22px;
    margin-bottom: 12px;
  }

  .empty-state p {
    color: #a0aec0;
    font-size: 14px;
  }

  .loading {
    text-align: center;
    padding: 40px;
    color: #6b7280;
  }

  .refresh-btn {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 10px 20px;
    border-radius: 10px;
    border: none;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: 'Poppins', sans-serif;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .refresh-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
  }

  @media (max-width: 768px) {
    .content-panel {
      padding: 20px;
    }

    .stats-overview {
      grid-template-columns: 1fr 1fr;
    }

    .filter-section {
      flex-direction: column;
    }

    .data-table {
      font-size: 12px;
    }

    .data-table th,
    .data-table td {
      padding: 10px 8px;
    }
  }
</style>

<div class="content-panel">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; flex-wrap: wrap; gap: 20px;">
    <div>
      <h1 class="gamification-title">📊 Gamification Statistics</h1>
      <p class="gamification-subtitle">View and analyze user learning progress and achievements</p>
    </div>
    <button class="refresh-btn" onclick="loadGamificationStats()">
      <span>🔄</span> Refresh Data
    </button>
  </div>

  <!-- Stats Overview -->
  <div class="stats-overview">
    <div class="stat-card">
      <div class="stat-icon">👥</div>
      <div class="stat-value" id="total-users">0</div>
      <div class="stat-label">Total Users</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">⭐</div>
      <div class="stat-value" id="total-xp">0</div>
      <div class="stat-label">Total XP</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🔥</div>
      <div class="stat-value" id="avg-streak">0</div>
      <div class="stat-label">Avg Streak</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🏅</div>
      <div class="stat-value" id="total-badges">0</div>
      <div class="stat-label">Badges Earned</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">📚</div>
      <div class="stat-value" id="total-lessons">0</div>
      <div class="stat-label">Lessons Done</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🍅</div>
      <div class="stat-value" id="total-pomodoros">0</div>
      <div class="stat-label">Pomodoros</div>
    </div>
  </div>

  <!-- Filters -->
  <div class="filter-section">
    <div class="filter-group">
      <label for="search-email">Search by Email</label>
      <input type="text" id="search-email" placeholder="user@example.com" onkeyup="filterUsers()">
    </div>
    <div class="filter-group">
      <label for="sort-by">Sort By</label>
      <select id="sort-by" onchange="sortUsers()">
        <option value="xp-desc">Highest XP</option>
        <option value="xp-asc">Lowest XP</option>
        <option value="streak-desc">Longest Streak</option>
        <option value="streak-asc">Shortest Streak</option>
        <option value="lessons-desc">Most Lessons</option>
        <option value="badges-desc">Most Badges</option>
      </select>
    </div>
  </div>

  <!-- Users Table -->
  <div class="table-container">
    <div id="loading-indicator" class="loading">
      <p>Loading gamification statistics...</p>
    </div>

    <table class="data-table" id="users-table" style="display: none;">
      <thead>
        <tr>
          <th>User Email</th>
          <th>Total XP</th>
          <th>Current Streak</th>
          <th>Highest Streak</th>
          <th>Badges</th>
          <th>Lessons</th>
          <th>Practice</th>
          <th>Pomodoros</th>
        </tr>
      </thead>
      <tbody id="users-tbody">
        <!-- Users will be loaded here -->
      </tbody>
    </table>

    <div id="empty-state" class="empty-state" style="display: none;">
      <div class="empty-state-icon">📊</div>
      <h3>No user statistics yet</h3>
      <p>Statistics will appear here as users complete activities</p>
    </div>
  </div>
</div>

<script>
  let allUsersStats = [];
  let filteredUsersStats = [];

  // Load gamification statistics
  async function loadGamificationStats() {
    try {
      document.getElementById('loading-indicator').style.display = 'block';
      document.getElementById('users-table').style.display = 'none';
      document.getElementById('empty-state').style.display = 'none';

      const response = await fetch('/admin/gamification/stats');
      const data = await response.json();

      if (data.success) {
        allUsersStats = data.users || [];
        filteredUsersStats = [...allUsersStats];
        
        updateOverviewStats(data.overview);
        displayUsers();
        
        document.getElementById('loading-indicator').style.display = 'none';
        
        if (allUsersStats.length === 0) {
          document.getElementById('empty-state').style.display = 'block';
        } else {
          document.getElementById('users-table').style.display = 'table';
        }
      } else {
        console.error('Error loading stats:', data.error);
        document.getElementById('loading-indicator').style.display = 'none';
        document.getElementById('empty-state').style.display = 'block';
      }
    } catch (error) {
      console.error('Error loading gamification stats:', error);
      document.getElementById('loading-indicator').style.display = 'none';
      document.getElementById('empty-state').style.display = 'block';
    }
  }

  // Update overview statistics
  function updateOverviewStats(overview) {
    if (!overview) return;

    document.getElementById('total-users').textContent = overview.total_users || 0;
    document.getElementById('total-xp').textContent = formatNumber(overview.total_xp || 0);
    document.getElementById('avg-streak').textContent = overview.avg_streak || 0;
    document.getElementById('total-badges').textContent = overview.total_badges || 0;
    document.getElementById('total-lessons').textContent = overview.total_lessons || 0;
    document.getElementById('total-pomodoros').textContent = overview.total_pomodoros || 0;
  }

  // Display users in table
  function displayUsers() {
    const tbody = document.getElementById('users-tbody');
    
    if (filteredUsersStats.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: #6b7280;">No users match your filters</td></tr>';
      return;
    }

    tbody.innerHTML = filteredUsersStats.map(user => `
      <tr>
        <td><span class="user-email">${user.email || 'Unknown'}</span></td>
        <td><span class="stat-badge stat-xp">${formatNumber(user.total_xp || 0)} XP</span></td>
        <td><span class="stat-badge stat-streak">🔥 ${user.current_streak || 0}</span></td>
        <td><span class="stat-badge stat-streak">🏆 ${user.longest_streak || 0}</span></td>
        <td><span class="stat-badge stat-badges">🏅 ${user.badges_earned || 0}</span></td>
        <td><span class="stat-badge stat-lessons">📚 ${user.lessons_completed || 0}</span></td>
        <td><span class="stat-badge stat-practice">✏️ ${user.practice_completed || 0}</span></td>
        <td><span class="stat-badge stat-pomodoro">🍅 ${user.pomodoros_completed || 0}</span></td>
      </tr>
    `).join('');
  }

  // Filter users by email
  function filterUsers() {
    const searchTerm = document.getElementById('search-email').value.toLowerCase();
    
    filteredUsersStats = allUsersStats.filter(user => 
      user.email && user.email.toLowerCase().includes(searchTerm)
    );
    
    displayUsers();
  }

  // Sort users
  function sortUsers() {
    const sortBy = document.getElementById('sort-by').value;
    
    filteredUsersStats.sort((a, b) => {
      switch(sortBy) {
        case 'xp-desc':
          return (b.total_xp || 0) - (a.total_xp || 0);
        case 'xp-asc':
          return (a.total_xp || 0) - (b.total_xp || 0);
        case 'streak-desc':
          return (b.current_streak || 0) - (a.current_streak || 0);
        case 'streak-asc':
          return (a.current_streak || 0) - (b.current_streak || 0);
        case 'lessons-desc':
          return (b.lessons_completed || 0) - (a.lessons_completed || 0);
        case 'badges-desc':
          return (b.badges_earned || 0) - (a.badges_earned || 0);
        default:
          return 0;
      }
    });
    
    displayUsers();
  }

  // Format large numbers
  function formatNumber(num) {
    if (num >= 1000000) {
      return (num / 1000000).toFixed(1) + 'M';
    } else if (num >= 1000) {
      return (num / 1000).toFixed(1) + 'k';
    }
    return num.toString();
  }

  // Load stats on page load
  loadGamificationStats();
</script>

<%- include('../partials/footer') %>
