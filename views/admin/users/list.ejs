<%- include('../partials/header', { pageTitle: 'User Management', activePage: 'users' }) %>

<h1 class="header-title">👥 User Management</h1>
<p class="header-subtitle">Manage all LearnGlow users</p>

<div class="content-panel">
  <!-- Search Box -->
  <div style="margin-bottom: 25px;">
    <input 
      type="text" 
      id="searchUser" 
      placeholder="🔍 Search users..."
      style="width: 100%; max-width: 400px; padding: 12px 20px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 16px; transition: border-color 0.3s ease;"
      onkeyup="searchUsers()"
      onfocus="this.style.borderColor='#667eea'"
      onblur="this.style.borderColor='#e2e8f0'"
    >
  </div>

  <% if (users.length > 0) { %>
    <div class="table-container">
      <table id="usersTable">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Type</th>
            <th>Status</th>
            <th>Created At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { 
            // Calculate if user is active (logged in within last 7 days)
            const lastLogin = user.last_login_at || user.last_sign_in_at || user.created_at;
            const lastLoginDate = new Date(lastLogin);
            const now = new Date();
            const daysDiff = Math.floor((now - lastLoginDate) / (1000 * 60 * 60 * 24));
            const isActive = daysDiff <= 7;
            
            // Get user type from user_metadata
            const userType = user.user_metadata?.user_type || 'none';
          %>
            <tr>
              <td><%= user.name || user.user_metadata?.name || 'N/A' %></td>
              <td><%= user.email || 'N/A' %></td>
              <td>
                <% if (userType === 'both') { %>
                  <span style="display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    Both
                  </span>
                <% } else if (userType === 'student') { %>
                  <span style="display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; background: #84fab0; color: #2d3748;">
                    Student
                  </span>
                <% } else if (userType === 'professional') { %>
                  <span style="display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; background: #ffecd2; color: #F59E0B;">
                    Professional
                  </span>
                <% } else { %>
                  <span style="display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; background: #e2e8f0; color: #718096;">
                    None
                  </span>
                <% } %>
              </td>
              <td>
                <span style="display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; background: <%= isActive ? '#84fab0' : '#ffd1dc' %>; color: <%= isActive ? '#2d3748' : '#c53030' %>;">
                  <%= isActive ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td><%= new Date(user.created_at).toLocaleDateString() %></td>
              <td>
                <form action="/admin/users/delete/<%= user.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                  <button type="submit" class="btn btn-danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="icon">👥</div>
      <h3>No users found</h3>
      <p>Users will appear here once they sign up through your frontend</p>
    </div>
  <% } %>
</div>

<script>
  function searchUsers() {
    const input = document.getElementById('searchUser');
    const filter = input.value.toLowerCase();
    const table = document.getElementById('usersTable');
    const rows = table.getElementsByTagName('tr');
    
    // Loop through all table rows (skip header)
    for (let i = 1; i < rows.length; i++) {
      const row = rows[i];
      const cells = row.getElementsByTagName('td');
      let found = false;
      
      // Search in Name and Email columns (first 2 columns)
      for (let j = 0; j < 2; j++) {
        if (cells[j]) {
          const cellText = cells[j].textContent || cells[j].innerText;
          if (cellText.toLowerCase().indexOf(filter) > -1) {
            found = true;
            break;
          }
        }
      }
      
      // Show or hide the row
      if (found) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    }
  }
</script>

<%- include('../partials/footer') %>